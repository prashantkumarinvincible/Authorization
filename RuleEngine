        this.justificationTemplate = justificationTemplate;
    }

    public void addCondition(RuleCondition condition) { this.conditions.add(condition); }

    public boolean evaluate(Map<String, List<String>> facts) {
        return conditions.stream().allMatch(condition -> condition.evaluate(facts));
    }
    
