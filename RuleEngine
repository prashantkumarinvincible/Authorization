    public String getTargetPk() { return targetPk; }
}
Grouping logic for the Engine
Instead of grouping by Outcome Name, we group by the unique combination of Target_Table + Target_PK.

Java
public class RuleTargetGroup {
    private final String targetTable;
    private final String targetPk;
    private final List<BusinessRule> rules = new ArrayList<>();

    public RuleTargetGroup(String targetTable, String targetPk) {
        this.targetTable = targetTable;
        this.targetPk = targetPk;
    }

    public void addRule(BusinessRule rule) { this.rules.add(rule); }

    public Optional<BusinessRule> evaluateAndGetMatchingRule(Map<String, List<String>> facts) {
        return rules.stream().filter(rule -> rule.evaluate(facts)).findFirst();
    }

    public String getTargetTable() { return targetTable; }
    public String getTargetPk() { return targetPk; }
}
The Engine Entry Point
Java
public class RuleEngine {
    private final List<RuleTargetGroup> targetGroups;

    public RuleEngine(List<RuleTargetGroup> targetGroups) {
        this.targetGroups = targetGroups;
    }

    public List<EvaluationResult> process(Map<String, List<String>> facts) {
        List<EvaluationResult> results = new ArrayList<>();

        for (RuleTargetGroup group : targetGroups) {
            Optional<BusinessRule> matchingRule = group.evaluateAndGetMatchingRule(facts);
            if (matchingRule.isPresent()) {
                BusinessRule rule = matchingRule.get();
                String justification = rule.buildJustification(facts);
                
                results.add(new EvaluationResult(group.getTargetTable(), group.getTargetPk(), justification));
            }
        }
        return results;
    }
}
4. Integration & The SPI Layer
Your SPI interface will now fetch rules based on the target table the calling service cares about.

The SPI Interface
