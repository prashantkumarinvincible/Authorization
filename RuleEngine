3. Java Implementation Architecture
Condition Evaluator Strategy
Java
import java.util.*;
import java.util.stream.Collectors;

public enum Operator {
    EQUALS {
        @Override
        public boolean evaluate(List<String> actual, String expected, Map<String, List<String>> context) {
            return actual != null && actual.contains(expected);
        }
    },
    NOT_EQUALS {
        @Override
        public boolean evaluate(List<String> actual, String expected, Map<String, List<String>> context) {
            return actual == null || actual.isEmpty() || !actual.contains(expected);
        }
    },
    IN {
        @Override
        public boolean evaluate(List<String> actual, String expected, Map<String, List<String>> context) {
            if (actual == null || actual.isEmpty()) return false;
            Set<String> expectedSet = Arrays.stream(expected.split("\\|")).map(String::trim).collect(Collectors.toSet());
            return actual.stream().anyMatch(expectedSet::contains);
        }
    },
    CONTAINS_ONLY {
        @Override
        public boolean evaluate(List<String> actual, String expected, Map<String, List<String>> context) {
            return actual != null && actual.size() == 1 && actual.contains(expected);
        }
    },
    CROSS_BORDER_MATCH {
        @Override
        public boolean evaluate(List<String> actualCollection, String dataAccessKey, Map<String, List<String>> context) {
            if (actualCollection == null || actualCollection.isEmpty()) return false;
            List<String> dataAccess = context.get(dataAccessKey);
            if (dataAccess == null || dataAccess.isEmpty()) return false;

            // Map DataAccess entries into collection-access pairs (e.g., "US-US" -> Collection: US, Access: US)
            Set<String> validSameCountryPairs = actualCollection.stream()
                    .map(country -> country + "-" + country)
                    .collect(Collectors.toSet());

            // Check if all DataAccess selections match same-country patterns
            return validSameCountryPairs.containsAll(dataAccess);
        }
    };

    public abstract boolean evaluate(List<String> actualValues, String expectedValue, Map<String, List<String>> context);
}
Data Models & Engine Execution
Java
public class RuleCondition {
    private String questionId;
    private Operator operator;
    private String expectedValue;

    public RuleCondition(String questionId, Operator operator, String expectedValue) {
        this.questionId = questionId;
        this.operator = operator;
        this.expectedValue = expectedValue;
    }

    public boolean evaluate(Map<String, List<String>> payload) {
        List<String> actualValues = payload.get(questionId);
        return operator.evaluate(actualValues, expectedValue, payload);
    }
}

public class BusinessRule {
    private String ruleName;
    private List<RuleCondition> conditions = new ArrayList<>();

    public BusinessRule(String ruleName) {
        this.ruleName = ruleName;
    }

    public void addCondition(RuleCondition condition) {
        this.conditions.add(condition);
    }

    public boolean evaluate(Map<String, List<String>> payload) {
        // All conditions must evaluate to TRUE (AND logic)
        return conditions.stream().allMatch(condition -> condition.evaluate(payload));
    }
}

public class DispositionRuleGroup {
    private String dispositionName;
    private List<BusinessRule> rules = new ArrayList<>();

    public DispositionRuleGroup(String dispositionName) {
        this.dispositionName = dispositionName;
    }

    public void addRule(BusinessRule rule) {
        this.rules.add(rule);
    }

    public boolean evaluate(Map<String, List<String>> payload) {
        // If ANY rule passes, disposition is satisfied (OR logic)
        return rules.stream().anyMatch(rule -> rule.evaluate(payload));
    }

    public String getDispositionName() {
        return dispositionName;
    }
}

public class RuleEngine {
    private final List<DispositionRuleGroup> dispositionGroups;

    public RuleEngine(List<DispositionRuleGroup> dispositionGroups) {
        this.dispositionGroups = dispositionGroups;
    }

    public List<String> process(Map<String, List<String>> payload) {
        return dispositionGroups.stream()
                .filter(group -> group.evaluate(payload))
                .map(DispositionRuleGroup::getDispositionName)
                .collect(Collectors.toList());
    }
}
4. Scalability Considerations
In-Memory Caching: Database calls per rule execution degrade throughput. Load active rules using Caffeine/Guava Cache or Spring @Cacheable and reload on metadata changes.

Extensibility via Custom Operators: Complex cross-field checks (such as CROSS_BORDER_MATCH) can be implemented as isolated strategies without disrupting standard evaluation flows.

