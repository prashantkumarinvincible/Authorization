Data Models with Justification Formulation
Java
public class RuleCondition {
    private final String questionId;
    private final Operator operator;
    private final String expectedValue;

    public RuleCondition(String questionId, Operator operator, String expectedValue) {
        this.questionId = questionId;
        this.operator = operator;
        this.expectedValue = expectedValue;
    }

    public boolean evaluate(Map<String, List<String>> payload) {
        List<String> actualValues = payload.get(questionId);
        return operator.evaluate(actualValues, expectedValue, payload);
    }
}

public class BusinessRule {
    private final String ruleName;
    private final String justificationTemplate;
    private final List<RuleCondition> conditions = new ArrayList<>();

    public BusinessRule(String ruleName, String justificationTemplate) {
        this.ruleName = ruleName;
        this.justificationTemplate = justificationTemplate;
    }

    public void addCondition(RuleCondition condition) {
        this.conditions.add(condition);
    }

    public boolean evaluate(Map<String, List<String>> payload) {
        return conditions.stream().allMatch(condition -> condition.evaluate(payload));
    }

    public String buildJustification(Map<String, List<String>> payload) {
        String template = this.justificationTemplate;
        for (Map.Entry<String, List<String>> entry : payload.entrySet()) {
            String placeholder = "{" + entry.getKey() + "}";
            if (template.contains(placeholder)) {
                template = template.replace(placeholder, String.join(", ", entry.getValue()));
            }
        }
        return template;
    }
}
4. Understanding & Initializing DispositionRuleGroup
What is DispositionRuleGroup?
It is a domain-driven container object. Instead of forcing the main processing engine loop to flatly evaluate hundreds of isolated business rules sequentially, it clusters rules under their intended target Disposition.

Where and How is it Initialized?
It is initialized at application boot time (or via a scheduled cache eviction routine) inside a Repository/Loader Class that maps relational rows from the Oracle Database into clustered domain objects.

Java
public class DispositionRuleGroup {
    private final String dispositionName;
    private final List<BusinessRule> rules = new ArrayList<>();

    public DispositionRuleGroup(String dispositionName) {
        this.dispositionName = dispositionName;
    }

    public void addRule(BusinessRule rule) {
        this.rules.add(rule);
    }

    // Evaluates rules and returns the first matching passing rule configuration
    public Optional<BusinessRule> evaluateAndGetMatchingRule(Map<String, List<String>> payload) {
        return rules.stream().filter(rule -> rule.evaluate(payload)).findFirst();
    }

    public String getDispositionName() { return dispositionName; }
}
Database Rule Loader (The Initialization Layer)
This service executes a joined database query to cleanly reconstruct the structure into memory.

Java
import java.sql.*;
import java.util.*;

public class DatabaseRuleLoader {

    private final Connection connection;

    public DatabaseRuleLoader(Connection connection) {
        this.connection = connection;
    }

    public List<DispositionRuleGroup> loadRulesFromDb() throws SQLException {
        String query = "SELECT d.DISPOSITION_NAME, r.RULE_ID, r.RULE_NAME, r.JUSTIFICATION_TEMPLATE, " +
                       "c.QUESTION_ID, c.OPERATOR, c.EXPECTED_VALUE " +
                       "FROM RULE_DISPOSITION d " +
                       "JOIN BUSINESS_RULE r ON d.DISPOSITION_ID = r.DISPOSITION_ID " +
                       "JOIN RULE_CONDITION c ON r.RULE_ID = c.RULE_ID " +
                       "WHERE d.IS_ACTIVE = 1 AND r.IS_ACTIVE = 1";

        Map<String, DispositionRuleGroup> groupMap = new LinkedHashMap<>();
        Map<Integer, BusinessRule> ruleMap = new HashMap<>();

        try (PreparedStatement stmt = connection.prepareStatement(query);
             ResultSet rs = stmt.executeQuery()) {

            while (rs.next()) {
                String dispName = rs.getString("DISPOSITION_NAME");
                int ruleId = rs.getInt("RULE_ID");
                String ruleName = rs.getString("RULE_NAME");
                String template = rs.getString("JUSTIFICATION_TEMPLATE");
                String questionId = rs.getString("QUESTION_ID");
                String operatorStr = rs.getString("OPERATOR");
                String expectedValue = rs.getString("EXPECTED_VALUE");

                // 1. Compute group container
                DispositionRuleGroup group = groupMap.computeIfAbsent(dispName, DispositionRuleGroup::new);

                // 2. Compute rule entity within group
                BusinessRule rule = ruleMap.computeIfAbsent(ruleId, id -> {
                    BusinessRule newRule = new BusinessRule(ruleName, template);
                    group.addRule(newRule);
                    return newRule;
                });

                // 3. Attach standard parsed conditions
                rule.addCondition(new RuleCondition(questionId, Operator.valueOf(operatorStr), expectedValue));
            }
        }
        return new ArrayList!(groupMap.values());
    }
}
Rule Engine Processing Entry Point
Java
public class RuleEngine {
    private final List<DispositionRuleGroup> dispositionGroups;

    public RuleEngine(List<DispositionRuleGroup> dispositionGroups) {
        this.dispositionGroups = dispositionGroups;
    }

    public List<EvaluationResult> process(Map<String, List<String>> payload) {
        List<EvaluationResult> results = new ArrayList<>();

        for (DispositionRuleGroup group : dispositionGroups) {
            Optional<BusinessRule> matchingRule = group.evaluateAndGetMatchingRule(payload);
            if (matchingRule.isPresent()) {
                BusinessRule rule = matchingRule.get();
                String justification = rule.buildJustification(payload);
                results.add(new EvaluationResult(group.getDispositionName(), justification));
            }
        }
        return results;
    }
}

Stateless Processing: The RuleEngine processing pipeline is thread-safe and stateless, allowing horizontal scaling across microservices.
